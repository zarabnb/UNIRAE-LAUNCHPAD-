NODE_ENV=development
PORT=4100
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500
DATABASE_URL=postgresql://unirae:unirae@localhost:5432/unirae?schema=public
INDEXER_POLL_MS=5000
INDEXER_BATCH_SIZE=500
# Mainnet endpoints/configuration. Keep these empty until contracts, feeds and DEXes are verified.
RPC_ETHEREUM_MAINNET=
RPC_BNB_MAINNET=
RPC_ROBINHOOD_MAINNET=
RPC_XLAYER_MAINNET=
CONFIRMATIONS_ETHEREUM_MAINNET=12
CONFIRMATIONS_BNB_MAINNET=15
CONFIRMATIONS_ROBINHOOD_MAINNET=12
CONFIRMATIONS_XLAYER_MAINNET=12
FACTORY_ETHEREUM_MAINNET=
FACTORY_BNB_MAINNET=
FACTORY_ROBINHOOD_MAINNET=
FACTORY_XLAYER_MAINNET=
NATIVE_USD_FEED_ETHEREUM_MAINNET=
NATIVE_USD_FEED_BNB_MAINNET=
NATIVE_USD_FEED_ROBINHOOD_MAINNET=
NATIVE_USD_FEED_XLAYER_MAINNET=
DEX_V2_ROUTER_ETHEREUM_MAINNET=
WRAPPED_NATIVE_ETHEREUM_MAINNET=
DEX_V2_ROUTER_BNB_MAINNET=
WRAPPED_NATIVE_BNB_MAINNET=
DEX_V2_ROUTER_ROBINHOOD_MAINNET=
WRAPPED_NATIVE_ROBINHOOD_MAINNET=
DEX_V2_ROUTER_XLAYER_MAINNET=
WRAPPED_NATIVE_XLAYER_MAINNET=
UNISWAP_V3_FACTORY_ETHEREUM_MAINNET=
UNISWAP_V3_FACTORY_BNB_MAINNET=
UNISWAP_V3_FACTORY_ROBINHOOD_MAINNET=
UNISWAP_V3_FACTORY_XLAYER_MAINNET=
FEE_VAULT_ETHEREUM_MAINNET=
FEE_VAULT_BNB_MAINNET=
FEE_VAULT_ROBINHOOD_MAINNET=
FEE_VAULT_XLAYER_MAINNET=
FEE_VAULT_START_BLOCK_ETHEREUM_MAINNET=
FEE_VAULT_START_BLOCK_BNB_MAINNET=
FEE_VAULT_START_BLOCK_ROBINHOOD_MAINNET=
FEE_VAULT_START_BLOCK_XLAYER_MAINNET=

RPC_BNB_TESTNET=
RPC_SEPOLIA=
RPC_ROBINHOOD_TESTNET=
RPC_XLAYER_TESTNET=
CONFIRMATIONS_BNB_TESTNET=8
CONFIRMATIONS_SEPOLIA=12
CONFIRMATIONS_ROBINHOOD_TESTNET=8
CONFIRMATIONS_XLAYER_TESTNET=8
FACTORY_BNB_TESTNET=
FACTORY_SEPOLIA=
FACTORY_ROBINHOOD_TESTNET=
FACTORY_XLAYER_TESTNET=
FACTORY_START_BLOCK_ETHEREUM_MAINNET=0
FACTORY_START_BLOCK_BNB_MAINNET=0
FACTORY_START_BLOCK_ROBINHOOD_MAINNET=0
FACTORY_START_BLOCK_XLAYER_MAINNET=0
FACTORY_START_BLOCK_BNB_TESTNET=0
FACTORY_START_BLOCK_SEPOLIA=0
FACTORY_START_BLOCK_ROBINHOOD_TESTNET=0
FACTORY_START_BLOCK_XLAYER_TESTNET=0
# Defaults match contracts/v1_1/UniraeFactoryV11.sol TokenLaunched event.
FACTORY_EVENT_ABI_BNB_TESTNET=event TokenLaunched(address indexed token, address indexed curve, address indexed creator, string name, string symbol, uint256 supply)
FACTORY_EVENT_ABI_SEPOLIA=event TokenLaunched(address indexed token, address indexed curve, address indexed creator, string name, string symbol, uint256 supply)
FACTORY_EVENT_ABI_ROBINHOOD_TESTNET=event TokenLaunched(address indexed token, address indexed curve, address indexed creator, string name, string symbol, uint256 supply)
FACTORY_EVENT_ABI_XLAYER_TESTNET=event TokenLaunched(address indexed token, address indexed curve, address indexed creator, string name, string symbol, uint256 supply)
# Required for wallet-auth bearer sessions; generate a random value of 32+ characters.
SESSION_SECRET=replace-with-a-random-32-character-minimum-secret

# Graduation uses a chain-verified Uniswap-V2-compatible router (DEX_V2_ROUTER_*).
# This router is distinct from the V3 indexer factory below.
# Post-graduation DEX indexing reads verified V2 pairs from graduation discovery
# and V3 pools from the operator-verified DexPool registry.
DEX_INDEXER_POLL_MS=7000

# Optional Chainlink native/USD aggregator feeds. Leave empty unless the feed is verified for the chain.
NATIVE_USD_FEED_BNB_TESTNET=
NATIVE_USD_FEED_SEPOLIA=
NATIVE_USD_FEED_ROBINHOOD_TESTNET=
NATIVE_USD_FEED_XLAYER_TESTNET=
ORACLE_MAX_AGE_SECONDS=3600

# Uniswap V3 pool allowlist configuration. V3 pools are registered only after
# their on-chain factory, token0/token1, fee tier and wrapped-native quote are verified.
DEX_V2_ROUTER_BNB_TESTNET=
WRAPPED_NATIVE_BNB_TESTNET=
DEX_V2_ROUTER_SEPOLIA=
WRAPPED_NATIVE_SEPOLIA=
DEX_V2_ROUTER_ROBINHOOD_TESTNET=
WRAPPED_NATIVE_ROBINHOOD_TESTNET=
DEX_V2_ROUTER_XLAYER_TESTNET=
WRAPPED_NATIVE_XLAYER_TESTNET=
UNISWAP_V3_FACTORY_BNB_TESTNET=
UNISWAP_V3_FACTORY_SEPOLIA=
UNISWAP_V3_FACTORY_ROBINHOOD_TESTNET=
UNISWAP_V3_FACTORY_XLAYER_TESTNET=

FEE_VAULT_BNB_TESTNET=
FEE_VAULT_START_BLOCK_BNB_TESTNET=

FEE_VAULT_SEPOLIA=
FEE_VAULT_START_BLOCK_SEPOLIA=

FEE_VAULT_ROBINHOOD_TESTNET=
FEE_VAULT_START_BLOCK_ROBINHOOD_TESTNET=

FEE_VAULT_XLAYER_TESTNET=
FEE_VAULT_START_BLOCK_XLAYER_TESTNET=
